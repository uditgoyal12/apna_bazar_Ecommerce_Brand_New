REACT_APP_SITE_NAME=APNA BAZAR
REACT_APP_API_URL=/api
PORT=3000
API_PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/
MONGODB_DB=apna_bazar
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
# Optional workaround for environments whose default DNS cannot resolve Atlas SRV records.
DNS_SERVERS=
# Set to 1 only when the production server is behind one trusted reverse proxy.
TRUST_PROXY=0
# Use `none` when frontend and API are deployed on different HTTPS domains.
COOKIE_SAME_SITE=lax
